# Copy to .env.local and fill in the values. This file stays in git.

# NVIDIA NIM (chat + embeddings)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CHAT_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_EMBEDDING_DIMS=2048
# Provider request budget: starts are spaced 60000/NVIDIA_RPM ms apart (40 = 1.5s).
NVIDIA_RPM=40

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (custom database sessions)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Email provider (Resend-compatible). Leave empty for preview mode (links
# print to the server log). Needed for production email verification.
EMAIL_API_KEY=
EMAIL_FROM="DocuMind <onboarding@resend.dev>"

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google sign-in (OAuth 2.0). Leave both empty to hide the feature honestly:
# the button stays disabled and says it is not configured on this deployment.
# Redirect URI to register with Google: {AUTH_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endpoint overrides for local stub testing only. Leave unset in real use.
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_USERINFO_URL=
